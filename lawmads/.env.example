# ---- Lawmads platform — copy to .env -------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Secrets — generate: openssl rand -hex 48
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_ISSUER=lawmads
JWT_AUDIENCE=lawmads-platform
# WordPress SSO compatibility (Phase-1 lawmads-sso plugin): tokens with this issuer are accepted at /auth/sso
WP_JWT_ISSUER=lawmads-wp
WP_JWT_AUDIENCE=lawmads-playground
SERVICE_HMAC_SECRET=change-me-service-hmac
CERTIFICATE_SIGNING_KEY=change-me-certificate-signing-key

DATABASE_URL=postgres://lawmads:lawmads@127.0.0.1:5432/lawmads
TEST_DATABASE_URL=postgres://lawmads:lawmads@127.0.0.1:5432/lawmads_test
REDIS_URL=redis://127.0.0.1:6379

# Code execution: judge0 | local  (local = dev/test process sandbox; never use in production)
EXECUTOR=local
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
GRADING_CALLBACK_BASE=http://api:4000
FREE_TIER_RUNTIME_MINUTES=120

# Optional LMS grade sync back to WordPress/Tutor (Phase-1 bridge)
WP_GRADE_ENDPOINT=
WP_APP_USER=
WP_APP_PASSWORD=

# Payments: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI: mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
